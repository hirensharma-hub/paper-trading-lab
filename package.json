{
  "name": "paper-trading-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic, paper-only quantitative trading research foundation.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "service": "tsx src/service-main.ts",
    "experiment": "tsx src/experiment-cli.ts",
    "experiment:smoke": "tsx src/experiment-cli.ts --synthetic --output /tmp/paper-trading-lab-smoke --overwrite",
    "manifest:init": "tsx src/data-cli.ts manifest:init",
    "validate-data": "tsx src/data-cli.ts validate-data",
    "splits:suggest": "tsx src/data-cli.ts splits:suggest",
    "data:download": "tsx src/data-download-cli.ts",
    "experiment:v2a": "tsx src/v2a-cli.ts",
    "experiment:v2b": "tsx src/v2b-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
